'use strict';
var id = 1;
var pushNotification = function(posTop, posRight, title, description, type) {
    var body = document.querySelector('body');
    body.insertAdjacentHTML('beforeend', '\n    <div id = "notification-'.concat(id, '" class="notification ').concat(type, '"">\n      <h2 class="title">').concat(title, "</h2>\n      <p>").concat(description, "</p>\n    </div>\n    "));
    var notification = document.querySelector('#notification-' + id);
    notification.style.top = posTop + 'px';
    notification.style.right = posRight + 'px';
    // notification.style.visibility = 'visible';
    id++;
    setTimeout(function() {
        // notification.style.visibility = 'hidden';
        notification.style.display = 'none';
    // notification.remove();
    }, 2000);
};
pushNotification(10, 10, 'Title of Success message', "Message example.\n Notification should contain title and description.", 'success');
pushNotification(160, 10, 'Title of Error message', "Message example.\n Notification should contain title and description.", 'error');
pushNotification(290, 10, 'Title of Warning message', "Message example.\n Notification should contain title and description.", 'warning');

